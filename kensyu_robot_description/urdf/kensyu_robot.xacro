<?xml version="1.0" ?>
<robot name="kensyu_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find kensyu_robot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find kensyu_robot_description)/urdf/kensyu_robot.trans" />
<link name="base_link">
  <inertial>
    <origin xyz="0.005279295414181325 9.850897552034393e-05 0.03083708561928651" rpy="0 0 0"/>
    <mass value="9.962726640099236"/>
    <inertia ixx="0.028621" iyy="0.035767" izz="0.045892" ixy="7.8e-05" iyz="-6e-06" ixz="-0.002218"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_satin"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel">
  <inertial>
    <origin xyz="-1.5737356115347323e-06 -0.003817509217392462 6.829714409919974e-07" rpy="0 0 0"/>
    <mass value="0.23460868621446282"/>
    <inertia ixx="9e-05" iyy="0.000167" izz="9e-05" ixy="-0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.06875 0.1064 -0.016" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_satin"/>
  </visual>
  <collision>
    <origin xyz="-0.06875 0.1064 -0.016" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel">
  <inertial>
    <origin xyz="2.0524258170645515e-06 0.00351786299218336 6.829930472330992e-07" rpy="0 0 0"/>
    <mass value="0.23460868621446282"/>
    <inertia ixx="9e-05" iyy="0.000167" izz="9e-05" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.068554 -0.106541 -0.016" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_satin"/>
  </visual>
  <collision>
    <origin xyz="-0.068554 -0.106541 -0.016" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lidar_link">
  <inertial>
    <origin xyz="0.00046 0.031855 -0.140056" rpy="0 0 0"/>
    <mass value="0.0"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.00046 0.031855 -0.140056" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/LiDAR_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="opaque677277"/>
  </visual>
  <collision>
    <origin xyz="0.00046 0.031855 -0.140056" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://kensyu_robot_description/meshes/LiDAR_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Revolute 4" type="continuous">
  <origin xyz="0.06875 -0.1064 0.016" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <axis xyz="-0.0 -1.0 -0.0"/>
</joint>

<joint name="Revolute 5" type="continuous">
  <origin xyz="0.068554 0.106541 0.016" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Rigid 6" type="fixed">
  <origin xyz="-0.00046 -0.031855 0.140056" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_link"/>
</joint>

</robot>
